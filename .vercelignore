# CLI deployments are sourced from the repository root because the existing Vercel
# project uses `app` as its Root Directory. Upload only that application tree.
/*
!app

# Local credentials, database artifacts and generated evidence must never be uploaded.
app/.local-secrets
app/backups
app/tests/results
app/**/.env*
app/**/.private-uploads
app/**/.media-uploads
app/**/.edge-profile*
app/**/.edge-csp-profile
app/**/node_modules
app/**/.next
app/**/.pnpm-store
app/**/dist
app/**/coverage
app/**/.vercel
app/**/*.dump
app/**/*.sql.gz
app/**/*.sqlite*
app/**/*.db
app/**/*.log
app/**/*.zip
app/**/*.tsbuildinfo

# Test and local operator sources are not required by the Vercel build.
app/tests
app/tools
app/web/test
