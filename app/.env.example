# Public origin of the protected Preview deployment.
OTONOM_SITE_URL=https://preview-host.example

# Server-only staging database connections. Keep values encrypted in Vercel.
OTONOM_DOMAIN_DATABASE_URL=postgresql://domain_role:replace-me@host/database?sslmode=require
OTONOM_CMS_DATABASE_URL=postgresql://cms_role:replace-me@host/database?sslmode=require
OTONOM_PG_POOL_MAX=2

# Migration-workstation only; never store the admin URL or one-shot gate in Vercel.
OTONOM_ADMIN_DATABASE_URL=postgresql://admin_role:replace-me@host/database?sslmode=require
OTONOM_DB=otonom_preview
OTONOM_ALLOW_REMOTE_MIGRATIONS=SYNTHETIC_PREVIEW_ONLY
OTONOM_EXPECTED_MIGRATION_HOST=host
OTONOM_EXPECTED_MIGRATION_DATABASE=otonom_preview
OTONOM_SEED_CREDENTIALS_FILE=preview_users.json

# Payload server secret; use a long random value and never expose it to the browser.
PAYLOAD_SECRET=replace-with-a-random-server-secret
# Optional dedicated HMAC salt. If omitted, hosted runtime derives a domain-separated salt from PAYLOAD_SECRET.
OTONOM_RATE_LIMIT_SALT=replace-with-an-independent-random-secret

# Mandatory Preview safety locks for Vercel.
OTONOM_FORCE_PREVIEW=1
OTONOM_DISABLE_UPLOADS=1
OTONOM_TRUST_PROXY=1
OTONOM_TEST_PAGES=0
# Local disposable-test harness only. The runtime hard-denies this capability on Vercel.
OTONOM_ENABLE_SYNTHETIC_COMMERCIAL_TESTS=0
# Local disposable-test harness only. Hosted RFQ collection remains disabled pending approved privacy/retention terms.
OTONOM_ENABLE_SYNTHETIC_RFQ_TESTS=0
